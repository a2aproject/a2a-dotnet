		<TargetFrameworks>net10.0;net8.0</TargetFrameworks>
		<RootNamespace>A2A</RootNamespace>
		<AssemblyName>A2A.Cli</AssemblyName>
		<LangVersion>12</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
